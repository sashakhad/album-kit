.env*
!.env.example

# album key (only on the bot's computer)
.album-key
.album-onboarding.json

# local takes for dev
album/audio/*
!album/audio/.gitkeep

# vercel
.vercel

# prisma generated client
src/generated/

# typescript
*.tsbuildinfo
next-env.d.ts
