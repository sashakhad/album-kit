generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Vote {
  id          String   @id @default(cuid())
  visitorId   String
  trackNumber Int
  versionSlug String
  takeLabel   String   @default("A")
  value       Int      @default(1)
  round       Int      @default(1)
  detailsExposed Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([visitorId, trackNumber, versionSlug, takeLabel, round])
  @@index([trackNumber, versionSlug, takeLabel])
}

model Download {
  id          String   @id @default(cuid())
  visitorId   String
  trackNumber Int
  versionSlug String
  takeLabel   String
  round       Int
  createdAt   DateTime @default(now())

  @@unique([visitorId, trackNumber, versionSlug, takeLabel])
  @@index([visitorId])
}

model VisitorRound {
  visitorId    String   @id
  currentRound Int      @default(1)
  updatedAt    DateTime @updatedAt
}

model JudgingState {
  id          String @id @default("default")
  latestRound Int    @default(1)
}

model TakeSighting {
  id           String   @id @default(cuid())
  versionSlug  String
  filename     String
  addedInRound Int
  createdAt    DateTime @default(now())

  @@unique([versionSlug, filename])
}

model ParkedTake {
  id          String   @id @default(cuid())
  versionSlug String
  trackNumber Int
  takeLabel   String
  createdAt   DateTime @default(now())

  @@unique([versionSlug, trackNumber, takeLabel])
  @@index([trackNumber])
}

// The database is the canonical settings store for chat and the site.
model AlbumSettings {
  id        String   @id @default("default")
  version   Int      @default(1)
  defaults  Json
  overrides Json
  updatedAt DateTime @updatedAt
}

model GenerationRound {
  id                 String   @id @default(cuid())
  status             String   @default("preparing")
  snapshot           Json
  estimate           Json
  authorization      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  jobs               ProviderJob[]
}

model ProviderJob {
  id          String   @id @default(cuid())
  roundId     String
  operationId String   @unique
  promptId    String
  providerId  String?
  status      String   @default("planned")
  output      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  round       GenerationRound @relation(fields: [roundId], references: [id])

  @@index([roundId])
}

model BlindOrder {
  round       Int
  trackNumber Int
  filenames   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([round, trackNumber])
}

model ListeningExposure {
  visitorId String
  round     Int
  exposedAt DateTime @default(now())

  @@id([visitorId, round])
}

model TakeProvenance {
  filename           String   @id
  promptId           String
  style              String
  writerHost         String
  writerProvider     String?
  requestedModel     String?
  observedModel      String?
  attribution        String
  promptRevision     Int
  executionId        String?
  sunoModel          String?
  generationId       String?
  generationSettings Json
  outputId           String?
  clipId             String?
  streamUrl          String?
  roundId            String
  parentTakeFilename String?
  variationRequestId String?
  promptInstructions String?
  createdAt          DateTime @default(now())
}

// An owner request is a durable handoff, not authorization to spend Suno credits.
model VariationRequest {
  id                 String   @id
  trackNumber        Int
  parentTakeFilename String
  requestedTakes     Int
  instructions       String
  status             String   @default("requested")
  roundId            String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([trackNumber, createdAt])
}

model AccessInvite {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  redeemedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
}

model OwnerSignInLink {
  tokenHash String   @id
  expiresAt DateTime
}

// The owner password is still ALBUM_KEY. This row only replaces it after a
// signed-in change. A redeploy whose ALBUM_KEY differs drops the row, so a
// reset does not need the previous password.
model OwnerPassword {
  id          String   @id @default("owner")
  password    String
  envAtChange String
  updatedAt   DateTime @updatedAt
}

model VoteAttempt {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

// Owner choices made in the final pass override pins in album.json.
// Null values explicitly clear a file-backed pin.
model ListenSelection {
  trackNumber Int
  slot        String
  setId       String?
  takeLabel   String?
  updatedAt   DateTime @updatedAt

  @@id([trackNumber, slot])
}
