# Postgres connection string used by Prisma. Neon in production.
# Local Docker (pnpm db:up):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scaffold?schema=public"

# Neon's integration also sets DATABASE_URL_UNPOOLED, a direct connection. The
# Prisma CLI uses it for migrations when it's set. Leave it unset locally.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Vercel Blob read-write token for the takes store. pnpm setup:site creates the
# store and vercel env pull writes the token to .env.local. Leave it unset in
# local dev to read takes from album/audio/ instead.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Set only after the connected store is verified private. The site refuses
# private publication if this is absent or different.
# BLOB_ACCESS="private"
# New setup marks the absence of legacy public takes. Existing sites must
# migrate/delete the old public objects before setting this after an audit.
# PRIVATE_BLOB_AUDITED="true"

# The owner password. Whoever has it can vote, upload and move takes.
# The owner picks it at setup. pnpm setup:site stores it as ALBUM_KEY.
# Any value works locally. The example below is only for this computer.
ALBUM_KEY="dev"
