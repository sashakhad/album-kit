# Postgres connection string used by Prisma. Neon in production.
# Local Docker (pnpm db:up):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scaffold?schema=public"

# Neon's integration also sets DATABASE_URL_UNPOOLED, a direct connection. The
# Prisma CLI uses it for migrations when it's set. Leave it unset locally.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Vercel Blob read-write token for the takes store. pnpm setup:site creates the
# store and vercel env pull writes the token to .env.local. Leave it unset in
# local dev to read takes from album/audio/ instead.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# The owner's passcode. Whoever has it can vote, upload and move takes.
# pnpm setup:site generates one for the deployed site. Any value works locally.
ALBUM_KEY="dev"
